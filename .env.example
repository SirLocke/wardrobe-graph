# Port for Web UI + REST API (/api/wardrobe) + MCP Server (/mcp)
PORT=3000

# Environment mode (development | production)
NODE_ENV=production

# Path to persistent JSON file for wardrobe, biometric profile, custom occasions & wear history
WARDROBE_DATA_FILE=./data/wardrobe-store.json

# Optional: Protect public self-hosted instances with HTTP Basic Auth
# Leave empty for local network / Tailscale / Cloudflare Access setups
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Optional: Custom paths for ./deploy.sh (defaults to ./docker-compose.yml and ./data)
COMPOSE_FILE=
SERVICE_NAME=
LIVE_DATA_DIR=
BACKUP_DIR=

# Optional: Public Vercel static deployment (no backend required, pure client-side IndexedDB)
# Set to 'true' in Vercel project environment variables
VITE_PUBLIC_CLIENT_ONLY=false

# Optional: Shop search base URL (defaults to Amazon.de: https://www.amazon.de/s?k={query} if empty)
# Examples:
#   Amazon Search (Default): https://www.amazon.de/s?k={query}
#   Zalando Search:          https://www.zalando.de/katalog/?q={query}
#   Google Shopping:         https://www.google.com/search?tbm=shop&q={query}
VITE_SHOP_BASE_URL=

# Optional: Affiliate / PartnerNet tracking parameter appended to shopping links
# Examples:
#   Amazon PartnerNet: tag=dein-partner-tag-21  (or simply: dein-partner-tag-21)
#   Awin / Custom Ref: ref=dein-partner-code
VITE_SHOP_AFFILIATE_PARAM=




